# ============================================
# CNAB Parser - Environment Variables (Template)
# ============================================
# Copy this file to configs/.env and adjust the values.

# --- General ---
DEBUG=true
SECRET_KEY=REPLACE-WITH-A-SECRET-KEY
JWT_SECRET=REPLACE-WITH-A-JWT-SECRET
ENVIRONMENT=development

# --- Service-to-service authentication (Fernet) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SERVICE_SECRET_KEY=REPLACE-WITH-A-FERNET-KEY

# --- PostgreSQL ---
DB_USER=cnab
DB_PASSWORD=cnab123
DB_HOST=db
DB_PORT=5432

# user-service database (Django)
DB_NAME=cnab_users
DATABASE_URL=postgresql://cnab:cnab123@db:5432/cnab_users

# cnab-service database (FastAPI/SQLAlchemy)
CNAB_DATABASE_URL=postgresql://cnab:cnab123@db:5432/cnab_data

# upload-service database (FastAPI/SQLAlchemy)
UPLOAD_DATABASE_URL=postgresql://cnab:cnab123@db:5432/cnab_uploads

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Services ---
USER_SERVICE_URL=http://user-service:8001
CNAB_SERVICE_URL=http://cnab-service:8002
UPLOAD_SERVICE_URL=http://upload-service:8003
