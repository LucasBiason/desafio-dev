              ]
            },
            {
              "name": "GET Retrieve User",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{encoded_token}}" }
                ],
                "url": {
                  "raw": "{{user_service_url}}/users/v1/users/{{target_user_id}}/",
