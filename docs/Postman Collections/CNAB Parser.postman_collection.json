              "name": "GET List Users",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{encoded_token}}" }
                ],
                "url": {
                  "raw": "{{user_service_url}}/users/v1/users/?is_active=true",
                  "host": ["{{user_service_url}}"],
                  "path": ["users", "v1", "users", ""],
                  "query": [
                    { "key": "is_active", "value": "true", "description": "Filter by active status (true/false)" },
                    { "key": "username", "value": "", "description": "Filter by username (exact match)", "disabled": true },
                    { "key": "email", "value": "", "description": "Filter by email (exact match)", "disabled": true },
                    { "key": "name", "value": "", "description": "Filter by first_name or last_name (contains)", "disabled": true }
                  ]
                },
                "description": "## List Users\n\nReturns a list of all users visible to the authenticated user.\n\n### Authorization\n- Superusers: see all users\n- Staff: see all non-superusers\n- Regular users: see only themselves\n\n### Query Parameters\n| Parameter | Type | Description |\n|-----------|------|-------------|\n| is_active | bool | Filter by active status |\n| username | string | Filter by exact username |\n| email | string | Filter by exact email |\n| name | string | Filter by name (contains match on first_name or last_name) |"
              },
              "response": [
                {
                  "name": "Success (200)",
                  "originalRequest": {
                    "method": "GET",
                    "header": [{ "key": "Authorization", "value": "Bearer {{encoded_token}}" }],
                    "url": { "raw": "{{user_service_url}}/users/v1/users/", "host": ["{{user_service_url}}"], "path": ["users", "v1", "users", ""] }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "body": "[\n  {\n    \"id\": 1,\n    \"username\": \"admin\",\n    \"email\": \"admin@cnab.com\",\n    \"first_name\": \"\",\n    \"last_name\": \"\",\n    \"is_active\": true,\n    \"is_staff\": true,\n    \"created_at\": \"2026-04-01T10:00:00.000000Z\",\n    \"updated_at\": \"2026-04-01T10:00:00.000000Z\"\n  }\n]"
                },
                {
                  "name": "Error - Not authenticated (403)",
                  "originalRequest": {
                    "method": "GET",
                    "header": [],
                    "url": { "raw": "{{user_service_url}}/users/v1/users/", "host": ["{{user_service_url}}"], "path": ["users", "v1", "users", ""] }
                  },
                  "status": "Forbidden",
                  "code": 403,
                  "_postman_previewlanguage": "json",
                  "body": "{\n  \"detail\": \"Invalid Authorization header format.\"\n}"
                }
              ]
            },
            {
              "name": "POST Create User",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "    const jsonData = pm.response.json();",
                      "    pm.environment.set('target_user_id', jsonData.id);",
                      "    console.log('Created user ID: ' + jsonData.id);",
                      "}",
                      "",
                      "pm.test('Status 201', () => pm.response.to.have.status(201));"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{encoded_token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"operador\",\n  \"email\": \"operador@cnab.com\",\n  \"password\": \"oper123456\",\n  \"first_name\": \"Operador\",\n  \"last_name\": \"CNAB\"\n}"
                },
                "url": {
                  "raw": "{{user_service_url}}/users/v1/users/",
                  "host": ["{{user_service_url}}"],
                  "path": ["users", "v1", "users", ""]
                },
                "description": "## Create User\n\nCreates a new user. Only staff or superuser can perform this action.\nThe created user ID is automatically saved to `target_user_id`.\n\n### Parameters\n| Field | Type | Required | Description |\n|-------|------|----------|-------------|\n| username | string | Yes | Unique username |\n| email | string | Yes | Unique email address |\n| password | string | Yes | User password |\n| first_name | string | No | First name |\n| last_name | string | No | Last name |\n\n### Validations\n- `username` must be unique: 400 \"Username already in use\"\n- `email` must be unique: 400 \"Email already registered\"\n- Only staff/superuser can create: 403 \"You do not have permission\"\n\n### Authorization\n- Requires `is_staff=True` or `is_superuser=True`"
              },
              "response": [
                {
                  "name": "Success (201)",
                  "originalRequest": {
                    "method": "POST",
                    "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{encoded_token}}" }],
                    "body": { "mode": "raw", "raw": "{\n  \"username\": \"operador\",\n  \"email\": \"operador@cnab.com\",\n  \"password\": \"oper123456\",\n  \"first_name\": \"Operador\",\n  \"last_name\": \"CNAB\"\n}" },
                    "url": { "raw": "{{user_service_url}}/users/v1/users/", "host": ["{{user_service_url}}"], "path": ["users", "v1", "users", ""] }
                  },
                  "status": "Created",
                  "code": 201,
                  "_postman_previewlanguage": "json",
                  "body": "{\n  \"id\": 2,\n  \"username\": \"operador\",\n  \"email\": \"operador@cnab.com\",\n  \"first_name\": \"Operador\",\n  \"last_name\": \"CNAB\",\n  \"is_active\": true,\n  \"is_staff\": false,\n  \"created_at\": \"2026-04-01T10:05:00.000000Z\",\n  \"updated_at\": \"2026-04-01T10:05:00.000000Z\"\n}"
                },
                {
                  "name": "Error - Unauthorized (403)",
                  "originalRequest": {
                    "method": "POST",
                    "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{encoded_token}}" }],
                    "body": { "mode": "raw", "raw": "{\n  \"username\": \"test\",\n  \"email\": \"test@cnab.com\",\n  \"password\": \"pass\"\n}" },
                    "url": { "raw": "{{user_service_url}}/users/v1/users/", "host": ["{{user_service_url}}"], "path": ["users", "v1", "users", ""] }
                  },
                  "status": "Forbidden",
                  "code": 403,
                  "_postman_previewlanguage": "json",
                  "body": "{\n  \"code\": 403,\n  \"detail\": \"You do not have permission to perform this action.\",\n  \"status\": \"UnauthorizedUser\"\n}"
                },
                {
