        {
          "name": "Upload",
          "description": "CNAB file upload and history management.",
          "item": [
            {
              "name": "POST Upload CNAB File",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "    const jsonData = pm.response.json();",
                      "    pm.environment.set('upload_id', jsonData.id);",
                      "    console.log('Upload ID: ' + jsonData.id);",
                      "}",
                      "",
